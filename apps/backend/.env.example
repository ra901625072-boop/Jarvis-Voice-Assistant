# ==============================================================================
# JARVIS CONFIGURATION TEMPLATE
# ==============================================================================

# --- 1. Google Gemini (Required for Realtime Voice & Vision) ---
# Get free key at: https://aistudio.google.com/
GEMINI_API_KEY=
LIVEKIT_GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
JARVIS_DEFAULT_GEMINI_MODEL=gemini-3.5-flash
JARVIS_GEMINI_FALLBACK_CHAIN=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-flash-lite-latest,gemini-3.7-flash,gemini-2.5-flash,gemini-3.1-pro-preview

# --- 2. Groq (Ultra-Fast Inference Engine) ---
# Get free key at: https://console.groq.com/
GROQ_API_KEY=
JARVIS_DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
JARVIS_GROQ_MODEL_SUPERVISOR=llama-3.3-70b-versatile
JARVIS_GROQ_MODEL_COORDINATOR=llama-3.3-70b-versatile
JARVIS_GROQ_MODEL_PLANNING=llama-3.3-70b-versatile
JARVIS_GROQ_MODEL_CODING=llama-3.3-70b-versatile
JARVIS_GROQ_MODEL_BROWSER=llama-3.3-70b-versatile
JARVIS_GROQ_MODEL_EXECUTION=llama-3.3-70b-versatile
JARVIS_GROQ_MODEL_MEMORY=llama-3.1-8b-instant
JARVIS_GROQ_MODEL_VERIFICATION=llama-3.1-8b-instant
JARVIS_GROQ_MODEL_DEBUGGING=llama-3.3-70b-versatile
JARVIS_GROQ_FALLBACK_CHAIN=llama-3.3-70b-versatile,llama-3.1-8b-instant,llama-3.1-70b-versatile,gemma2-9b-it

# --- 3. OpenRouter (Free Deep Reasoning & Specialized Coding) ---
# Get free key at: https://openrouter.ai/
OPENROUTER_API_KEY=
JARVIS_DEFAULT_OPENROUTER_MODEL=openrouter/free
JARVIS_OPENROUTER_MODEL_CODING=qwen/qwen-2.5-coder-32b-instruct:free
JARVIS_OPENROUTER_MODEL_DEBUGGING=deepseek/deepseek-r1:free
JARVIS_OPENROUTER_MODEL_PLANNING=deepseek/deepseek-r1:free
JARVIS_OPENROUTER_FREE_FALLBACK_CHAIN=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-coder-32b-instruct:free,deepseek/deepseek-r1:free

# --- LiveKit WebRTC Voice Connection Credentials ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Local Agent Security ---
AGENT_NAME=jarvis
JARVIS_API_KEY=
JARVIS_JWT_SECRET=
JARVIS_AUTO_CONFIRM=true
JARVIS_TOOL_TIMEOUT=600

# --- MCP Integration ---
JARVIS_ENABLE_MCP=false
BRAVE_API_KEY=
JARVIS_MCP_FS_ROOT=
JARVIS_MCP_GIT_REPO=

# --- JARVIS Proactive Speech and Announcer Settings ---
JARVIS_PROACTIVE_SPEECH_ENABLED=true
JARVIS_ANNOUNCE_MILESTONES=25,50,75,100
JARVIS_ANNOUNCE_BATCH_WINDOW_SEC=1.5
JARVIS_ANNOUNCE_MIN_TASK_DURATION_SEC=5
JARVIS_ANNOUNCE_DEFAULT_PRIORITY=normal

# --- Email (SMTP) Configuration Settings ---
JARVIS_SMTP_HOST=smtp.gmail.com
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=
JARVIS_SMTP_PASS=
JARVIS_SMTP_SENDER=

# --- Mobile SMS (Twilio) Configuration Settings ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Dedicated Browser Profile & Account Storage Settings ---
JARVIS_BROWSER_TYPE=msedge
JARVIS_BROWSER_PROFILE_DIR=
JARVIS_BROWSER_HEADLESS=false
