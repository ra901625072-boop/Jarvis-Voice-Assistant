# Google Gemini API key (Required for voice & vision analysis)
GEMINI_API_KEY=

# OpenRouter API key (Optional fallback for other LLM models)
OPENROUTER_API_KEY=

# Groq API key (Optional fast inference)
GROQ_API_KEY=

# LiveKit Web RTC Connection Credentials (Required for dashboard voice link)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local Agent configuration
AGENT_NAME=jarvis
# Required — server will not start without this
JARVIS_API_KEY=

# MCP Integration (Optional — enhances JARVIS with web search, file sandbox, git)
# Brave Search API key — get one free at https://brave.com/search/api/
BRAVE_API_KEY=
# Sandboxed filesystem root for MCP file operations (default: ~/jarvis_workspace)
JARVIS_MCP_FS_ROOT=
# Git repository path for MCP git operations (default: same as JARVIS_MCP_FS_ROOT)
JARVIS_MCP_GIT_REPO=
